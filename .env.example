# Optional: only needed if you want to use a local Ollama model instead of
# the deterministic fallback reasoning. The app runs fully without these.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Comma-separated frontend URLs permitted to call the deployed FastAPI API.
# Example: https://your-nexus-frontend.vercel.app
CORS_ALLOW_ORIGINS=

# Optional override for the SQLite location. Vercel automatically uses /tmp.
NEXUS_DB_PATH=
